# bump: libxml2-version /LIBXML2_VERSION="(.*)"/ https://download.gnome.org/sources/libxml2/cache.json|re:/"([\d]+\.[\d]+\.[\d]+)":\s*\{[^}]*"tar\.xz"/$1/|semver:*
LIBXML2_VERSION="2.15.4"

export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_CATEGORIES="library"
export ZOPEN_STABLE_URL="https://download.gnome.org/sources/libxml2/$(echo ${LIBXML2_VERSION} | cut -d. -f1,2)/libxml2-${LIBXML2_VERSION}.tar.xz"
export ZOPEN_STABLE_DEPS="make sed diffutils coreutils findutils libiconv bash check_python pkgconfig gawk"
export ZOPEN_EXTRA_CONFIGURE_OPTS="--without-modules"
#export ZOPEN_EXTRA_CONFIGURE_OPTS='--with-python=yes --with-python-install-dir=$ZOPEN_INSTALL_DIR/site-packages'

# Requires python3
zopen_init()
{
  python3 -m venv xml2_python
  . ./xml2_python/bin/activate
}
zopen_terminate()
{
  deactivate
}

zopen_check_results()
{
  dir="$1"
  pfx="$2"
  chk="$1/$2_check.log"

  eval $(awk '/^Total [0-9]+ tests/ {
    tests += $2
    if ($4 ~ /^[0-9]+$/) {
      failures += $4
    }
  }
  END {
    printf("totalTests=%d\nactualFailures=%d\n", tests, failures)
  }' "${chk}")

  expectedFailures=0

  echo "actualFailures:${actualFailures}"
  echo "totalTests:${totalTests}"
  echo "expectedFailures:${expectedFailures}"
}

zopen_append_to_env()
{
cat <<ZZ
if [ ! -z "\$ZOPEN_IN_ZOPEN_BUILD" ]; then
  export ZOPEN_EXTRA_CFLAGS="\${ZOPEN_EXTRA_CFLAGS} -I\$PWD/include -I\$PWD/include/libxml2"
  export ZOPEN_EXTRA_CXXFLAGS="\${ZOPEN_EXTRA_CXXFLAGS} -I\$PWD/include -I\$PWD/include/libxml2"
  export ZOPEN_EXTRA_LDFLAGS="\${ZOPEN_EXTRA_LDFLAGS} -L\$PWD/lib"
  export ZOPEN_EXTRA_LIBS="\${ZOPEN_EXTRA_LIBS} -lxml2"

  #
  # For php
  #
  export LIBXML_CFLAGS="-I\$PWD/include" 
  export LIBXML_LIBS="-lxml2"
fi
ZZ
}

zopen_get_version() {
  ./xml2-config --version
}
